# ---- Inkloom AI Frontend — environment variables ----
# Copy to .env.local for local dev.
# For Render.com: set as environment variables in the Render dashboard.

# URL of the FastAPI backend
# Local dev:  http://localhost:8000
# Render:     https://inkloom-backend.onrender.com  (your actual Render service URL)
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# Set to true to force offline mock data (no backend required)
NEXT_PUBLIC_USE_MOCK=false