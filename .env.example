# Inkloom AI (Inkoom AI) Environment Configuration
# Connected AI Backend via Cloudflare Tunnel:
NEXT_PUBLIC_AI_API_URL=https://inkoom-model.shubhamos.com

# Public AI API Key (if authentication header is required by your FastAPI backend):
NEXT_PUBLIC_AI_API_KEY=

# Set to true to force client-side mock data without hitting the external backend:
NEXT_PUBLIC_USE_MOCK=false