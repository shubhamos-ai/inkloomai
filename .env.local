# ---- Inkloom AI Frontend — local development ----
# For production on Render, set NEXT_PUBLIC_AI_API_URL to your Render backend URL.
# Example: https://inkloom-backend.onrender.com

# Backend URL — local dev points to FastAPI running on :8000
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# Set to true to force offline mock data (no backend required)
NEXT_PUBLIC_USE_MOCK=false