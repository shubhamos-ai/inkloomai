# ---- Inkloom AI backend environment (copy to .env — never commit .env) ----

# Application
DEBUG=true

# Database: SQLite locally; switch to PostgreSQL in production.
DATABASE_URL=sqlite://./data/inkloom.db
# Example production URL:
# DATABASE_URL=postgresql://inkloom:CHANGE_ME@localhost:5432/inkloom

# Storage (relative to server/)
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# --- SECURITY ---
# Shared dev bearer token for frontend integration (clearly marked DEV mode).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_AUTH_TOKEN=replace-me-with-a-long-random-dev-token
# Set true in production to completely disable dev auth:
DISABLE_DEV_AUTH=false

# Frontend origin (exact; no wildcards).
CORS_ORIGINS=https://inkloom-ai.shubhamos.com,https://inkoom-ai.shubhamos.com
# Only if you need local web dev:
CORS_EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (requests/minute/IP)
RATE_LIMIT_PER_MINUTE=120

# ----------------------------------------------------------------------
# AI Vision Provider Selection
# ----------------------------------------------------------------------
# Options: "nvidia_nim" (production - RECOMMENDED for Render.com deployment)
#          "ollama" (local development only)
#          "mock" (testing)
VISION_PROVIDER=nvidia_nim

# ----------------------------------------------------------------------
# NVIDIA NIM API (Production - Deployable on Render.com)
# ----------------------------------------------------------------------
# Get your free API key from: https://build.nvidia.com
# Example format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=your-api-key-here
# Vision model served by integrate.api.nvidia.com/v1 (llama-3.2-11b-vision EOL'd 2026-11-05)
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# ----------------------------------------------------------------------
# Ollama (Local Development Only - NOT for production)
# ----------------------------------------------------------------------
# Only used when VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model name (e.g., gemma3:4b, llama3.2-vision)
OLLAMA_VISION_MODEL=

# ----------------------------------------------------------------------
# Analysis pipeline
# ----------------------------------------------------------------------
# "mock"  -> clearly-labelled mock output (no AI inference)
# "ai"    -> real inference via configured VISION_PROVIDER
PIPELINE_MODE=ai

# ----------------------------------------------------------------------
# Background worker
# ----------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=1.0
STALE_JOB_AFTER_SECONDS=300
MAX_JOB_ATTEMPTS=3

# ----------------------------------------------------------------------
# Object Storage (S3-compatible)
# ----------------------------------------------------------------------
# "auto" uses S3 when S3_BUCKET is set, falls back to local disk otherwise.
# Options: auto | s3 | local
STORAGE_BACKEND=auto
# Cloudflare R2 / AWS S3 / MinIO credentials:
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=inkloom/
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRES_SECONDS=3600
# Local cache directory for S3-sourced files (Pillow needs local path)
STORAGE_CACHE_DIR=./cache
PREVIEW_MAX_DIMENSION=1024

# ----------------------------------------------------------------------
# AI Brand-Rule Extraction
# ----------------------------------------------------------------------
# Provider for structured text extraction (auto uses NVIDIA NIM if available)
# Options: auto | nvidia_nim | mock
EXTRACTION_PROVIDER=auto
# Max characters per document chunk sent to extraction LLM
EXTRACTION_CHUNK_SIZE=8000
# Max rules the model may propose per chunk
EXTRACTION_MAX_RULES_PER_CHUNK=20

# ----------------------------------------------------------------------
# Session security
# ----------------------------------------------------------------------
# Secret used to sign/verify session tokens. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=replace-me-with-a-long-random-secret