# ---- Inkloom AI backend environment (copy to .env — never commit .env) ----

# Application
DEBUG=true

# Database: MongoDB (local dev or Atlas in production).
DATABASE_URL=mongodb://127.0.0.1:27017/inkloom
MONGODB_DB_NAME=inkloom
# Example production URL:
# DATABASE_URL=mongodb+srv://user:PASSWORD@cluster.example.mongodb.net/?appName=inkloom

# Storage (relative to server/)
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# --- SECURITY ---
# Shared dev bearer token for frontend integration (clearly marked DEV mode).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEV_AUTH_TOKEN=replace-me-with-a-long-random-dev-token
# Set true in production to completely disable dev auth:
DISABLE_DEV_AUTH=false

# Frontend origin (exact; no wildcards).
CORS_ORIGINS=https://inkoom-ai.shubhamos.com
# Only if you need local web dev:
CORS_EXTRA_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (requests/minute/IP)
RATE_LIMIT_PER_MINUTE=120

# --- Ollama (local only; NEVER expose port 11434 through the tunnel) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set once the Vision SLM finishes downloading (tag from `ollama list`):
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=300

# --- Analysis pipeline ---
# mock = clearly-labelled infrastructure test run (no AI inference)
# ai   = real pipeline via Ollama (falls back to labelled mock if model absent)
PIPELINE_MODE=mock

# --- Background worker ---
WORKER_POLL_INTERVAL_SECONDS=1.0
STALE_JOB_AFTER_SECONDS=300
MAX_JOB_ATTEMPTS=3
